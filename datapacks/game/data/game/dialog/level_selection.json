            "action":{
                "type":"run_command",
                "command":"/trigger game.trigger.level_chosen set 3"
            }
        },
        {
            "label":"Level 4: Ravine",
            "action":{
                "type":"run_command",
                "command":"/trigger game.trigger.level_chosen set 4"
            }
        },
        {
            "label":"Level 5: Mineshaft 1",
            "action":{
                "type":"run_command",
                "command":"/trigger game.trigger.level_chosen set 5"
            }
        },
        {
            "label":"Level 6: Mineshaft 2",
            "action":{
                "type":"run_command",
                "command":"/trigger game.trigger.level_chosen set 6"
            }
        },
        {
