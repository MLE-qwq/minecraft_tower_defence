{
    "type":"minecraft:multi_action",
    "title":"Game Menu",
    "columns":1,
    "body":[{"type": "plain_message", "contents": "Note: You'll have to turn off Menu Background Blur as in [Options... > Accessibility Settings...] to be able to view the statistics during gameplay."}],
    "pause": false,
    "actions":[
        {
            "label":"Level Selection",
            "action":{
                "type":"run_command",
                "command":"/trigger game.trigger.level_chosen set -1001"
            }
        },
        {
            "label":"Settings",
            "action":{
                "type":"run_command",
                "command":"/trigger game.trigger.level_chosen set -1002"
            }
        }
    ],
    "exit_action":{
        "label":"Cancel"
    }
}