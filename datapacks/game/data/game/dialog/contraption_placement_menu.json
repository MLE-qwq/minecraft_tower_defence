{
    "type":"minecraft:multi_action",
    "title":"Game Menu - Contraption Placement",
    "columns":1,
    "pause": false,
    "body":[
        {
            "type":"minecraft:plain_message",
            "contents":"Choose an action to operate:"
        }
    ],
    "actions":[
        {
            "label":"Toggle Pause",
            "action":{
                "type":"run_command",
                "command":"/trigger game.trigger.operation set -2"
            }
        },
        {
            "label":"Skip Countdown",
            "action":{
                "type":"run_command",
                "command":"/trigger game.trigger.operation set 1"
            }
        },
        {
            "label":"Purchase Menu",
            "action":{
                "type":"run_command",
                "command":"/trigger game.trigger.operation set 2"
            }
        },
        {
            "label":"Quit Level",
            "action":{
                "type":"run_command",
                "command":"/trigger game.trigger.operation set -1"
            }
        }
    ],
    "exit_action":{
        "label":"Cancel"
    }
}